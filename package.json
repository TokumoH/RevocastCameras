{
  "name": "teste",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "node scripts/install-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "check-docs": "node scripts/check-docs.mjs",
    "check-doc-secrets": "node scripts/check-doc-secrets.mjs",
    "check-deps-audit": "npm audit --audit-level=high",
    "check-registro": "node scripts/check-registro.mjs",
    "check": "npm run typecheck && npm test && npm run check-docs && npm run check-doc-secrets && npm run check-deps-audit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

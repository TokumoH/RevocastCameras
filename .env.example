# Copie este arquivo para .env.local (ignorado pelo git) e preencha os valores.
# Nunca coloque valores reais aqui: este arquivo é versionado.

# Obrigatórias: projeto Supabase. URL: só a origem, ex.: https://<ref>.supabase.co (sem /rest/v1); chave publicável (nunca a secreta sb_secret_).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcionais: servidor TURN. Só valem se as três estiverem preenchidas.
VITE_TURN_URL=
VITE_TURN_USUARIO=
VITE_TURN_SENHA=
